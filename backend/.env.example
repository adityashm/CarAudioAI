# Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/caraudio_dev

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Twilio (Phone OTP - Get FREE $50 credit from GitHub Student Pack)
# https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_PHONE=+919xxxxxxxxx

# Razorpay (Indian Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# DigitalOcean Spaces (Get FREE $200 credit from GitHub Student Pack)
# https://digitalocean.com/github-students
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_BUCKET=caraudio-files

# Sentry (Error Tracking - FREE for students)
# https://sentry.io/for/education/
SENTRY_DSN=https://xxxxx@sentry.io/xxxxxx
SENTRY_ENVIRONMENT=development

# CORS Origins (comma-separated)
# Add your mobile app URLs here
